rng(0,'v5uniform');
n=100;
m=300;
A=rand(m,n);
b=A*ones(n,1)/2;
c=-rand(n,1);
cvx_begin
    variable xrlx(n)
    minimize (c' * xrlx)
    subject to
        A * xrlx <= b
        0 <= xrlx <= 1
cvx_end

xi = double(0);
t = linspace(0, 1, 100);
obj = zeros(1, 100);
maxviol = zeros(1, 100);
for i = 1:100
    xi = double(xrlx >= t(i));
    obj(i) = c' * xi;
    maxviol(i) = max(A * xi - b);
    end

figure;
subplot(2, 1, 1);
plot(t, obj, 'b-', 'LineWidth', 1.5);
xlabel('Threshold t');
ylabel('Objective Value (c^T \hat{x}');
grid on;

subplot(2, 1, 2);
plot(t, maxviol, 'r-', 'LineWidth', 1.5);
hold on;
yline(0, 'k--', 'feasible Limit');
xlabel('Threshold t');
ylabel('Max Violation max_i (A\hat{x} - b)_i');
grid on;

U = min(obj(find(maxviol<=0)));
disp(U - c' * xrlx);

